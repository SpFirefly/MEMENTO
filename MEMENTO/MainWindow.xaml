<Window x:Class="MEMENTO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MEMENTO"
        mc:Ignorable="d"
        Title="MEMENTO" Height="988" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <!-- Win11 Fluent 颜色 -->
        <FontFamily x:Key="DeyiHeiFont">pack://application:,,,/Fonts/#Smiley Sans</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DeyiHeiFont}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource DeyiHeiFont}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource DeyiHeiFont}"/>
        </Style>
        <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#E5F0FF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E5F0FF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>

        <!-- 圆角按钮样式 -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 导航按钮样式 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 复选框样式 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Minimum" Value="20"/>
            <Setter Property="Maximum" Value="80"/>
            <Setter Property="Value" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧边栏 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 按钮 -->
                <StackPanel Grid.Row="1" Margin="12,16,12,10">
                    <Button x:Name="OpenFolderBtn" Click="OpenFolder_Click" Style="{StaticResource NavButton}" 
                            Content="打开文件夹" Margin="0,2" FontFamily="pack://application:,,,/Fonts/#Smiley Sans"/>
                    <Button x:Name="OpenMarkableBtn" Click="OpenMarkable_Click" Style="{StaticResource NavButton}" 
                            Content="与 MARKABLE 协同" Margin="0,2" FontFamily="pack://application:,,,/Fonts/#Smiley Sans"/>
                </StackPanel>

                <!-- 筛选 -->
                <Border Grid.Row="2" Background="{StaticResource HoverBrush}" CornerRadius="8" 
                        Margin="12,5,12,16" Padding="12,12">
                    <StackPanel>
                        <TextBlock Text="筛选" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最低评分：" VerticalAlignment="Center" FontSize="13" Width="70"/>
                            <ComboBox x:Name="RatingFilterCombo" SelectedIndex="0" Width="80" 
                                      SelectionChanged="RatingFilter_Changed" FontFamily="pack://application:,,,/Fonts/#Smiley Sans">
                                <ComboBoxItem>全部</ComboBoxItem>
                                <ComboBoxItem>1⭐</ComboBoxItem>
                                <ComboBoxItem>2⭐</ComboBoxItem>
                                <ComboBoxItem>3⭐</ComboBoxItem>
                                <ComboBoxItem>4⭐</ComboBoxItem>
                                <ComboBoxItem>5⭐</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 照片列表 -->
                <ListBox Grid.Row="3" x:Name="PhotoListBox" 
                         SelectionChanged="PhotoListBox_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,4,0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="8" Margin="8,2,8,2" Padding="8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="6" Background="#F0F0F0" Margin="0,0,12,0">
                                        <Image Width="36" Height="36" Stretch="Uniform" Source="{Binding Thumbnail}"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding RatingText}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 状态栏 -->
                <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <TextBlock x:Name="StatusText" Text="已就绪" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Background="#FAFAFA">
            <StackPanel Margin="32,24,32,24">

                <!-- 预览卡片 -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="预览" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="20,16,0,12"/>

                        <Border Background="#FAFAFA" CornerRadius="8" Margin="20,0,20,12"
                                Height="450">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="430"/>
                            </ScrollViewer>
                        </Border>
                        <!-- EXIF info -->
                        <Border Background="{StaticResource HoverBrush}" CornerRadius="8" Margin="20,0,20,0" Padding="16,12">
                            <Grid> 
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"> 
                                    <TextBlock Text="相机" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="CameraModelText" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                    <TextBlock Text="镜头" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0"/>
                                    <TextBlock x:Name="LensModelText" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="拍摄日期" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="DateTimeText" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 设置卡片 -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,20,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="边框设置" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="摄影师" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ArtistTextBox" Height="36" 
                                         VerticalContentAlignment="Center" Padding="12,0"
                                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0">
                                <TextBlock Text="显示选项" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ShowLogoCheckBox" Content="显示相机信息" IsChecked="True" FontFamily="pack://application:,,,/Fonts/#Smiley Sans"/>
                                <CheckBox x:Name="ShowExifCheckBox" Content="显示拍摄参数" IsChecked="True" Margin="0,8,0,0" FontFamily="pack://application:,,,/Fonts/#Smiley Sans"/>

                                <TextBlock Text="字体" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,4"  FontFamily="pack://application:,,,/Fonts/#Smiley Sans"/>
                                <ComboBox x:Name="FontComboBox" Width="140" SelectedIndex="0"  FontFamily="pack://application:,,,/Fonts/#Smiley Sans" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Segoe UI"/>
                                    <ComboBoxItem Content="Georgia"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Calibri"/>
                                    <ComboBoxItem Content="Microsoft YaHei"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                <TextBlock Text="顶部间距" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <Slider x:Name="BorderThicknessSlider" Minimum="20" Maximum="80" Value="40" Width="160"/>
                                <TextBlock Text="{Binding Value, ElementName=BorderThicknessSlider, StringFormat={}{0:F0}px}" 
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="RefreshBtn" Content="刷新预览" Click="RefreshPreview_Click" FontFamily="pack://application:,,,/Fonts/#Smiley Sans"
                                    Style="{StaticResource FluentButton}" Width="90" Margin="0,0,12,0"/>
                            <Button x:Name="SaveImageBtn" Content="保存 JPG" Click="SaveImage_Click" FontFamily="pack://application:,,,/Fonts/#Smiley Sans"
                                    Style="{StaticResource FluentButton}" Background="{StaticResource AccentBrush}" 
                                    Foreground="White" BorderThickness="0" Width="90"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>